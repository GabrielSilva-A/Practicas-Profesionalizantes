root = true

# Convenciones generales de archivos de texto
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown puede usar dos espacios finales para saltos de línea
[*.md]
trim_trailing_whitespace = false

# Mantener el estilo del SQL existente
[*.sql]
indent_size = 4
