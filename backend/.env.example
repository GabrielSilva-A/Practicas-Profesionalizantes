# Variables de entorno del backend (plantilla sin secretos)
# Copiar a .env y completar con valores locales reales. No versionar .env.

NODE_ENV=development
PORT=3000

# Cadena de conexión de PostgreSQL para Prisma.
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/uatre_dev?schema=public"

# Zona horaria operativa fija del sistema (RN-168).
TZ=America/Argentina/Buenos_Aires

# Orígenes permitidos para las operaciones POST del frontend.
# En producción, configurar aquí el origen HTTPS real del cliente.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
